# mtel-skill-registry — docker compose configuration
#
# Copy to .env and edit. `.env` is gitignored; this example file is not.
#   cp .env.example .env
#
# Compose reads .env from this directory automatically for interpolation, so
# `docker compose up -d` picks these up with no extra flags. Every value below
# has a default baked into docker-compose.yaml — an empty .env is a valid .env,
# and no .env at all is fine too.

# Port published on the host. Open http://localhost:<HOST_PORT> in a browser.
# The Cloudflare tunnel on the host points at this port.
HOST_PORT=3487

# Host interface to bind to. 127.0.0.1 keeps the resolver off the machine's
# public interfaces (the tunnel reaches it over loopback). Use 0.0.0.0 only if
# something outside this host must connect directly.
HOST_BIND=127.0.0.1

# Port the resolver listens on *inside* the container (http.js reads PORT).
# Rarely worth changing — adjust HOST_PORT instead.
CONTAINER_PORT=3000

# Optional bearer token. When set, it gates /mcp, /bundle.json and /skills/*.
# The landing page, setup docs and /health stay open either way.
# Leave empty for an unauthenticated registry.
MCP_AUTH_TOKEN=
